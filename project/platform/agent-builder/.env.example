# MainStreet AI Agent Builder — Environment Configuration
# Set at least ONE LLM provider key. Priority: Groq → OpenAI → Anthropic → Gemini

# Recommended: Groq (fastest, cheapest for small business use)
GROQ_API_KEY=""

# Alternative providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Force a specific provider (optional — auto-selects first available by default)
# LLM_PROVIDER="groq"

# Server port (default: 3000)
PORT=3000
