# TTS Service Environment Variables

# Server
PORT=8100
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Paths
VOICES_DIR=./voices
OUTPUT_DIR=./output

# Model
PRELOAD_MODEL=true  # Load model at startup (uses VRAM immediately)

# Device (auto-detected, but can override)
# DEVICE=cuda  # cuda | cpu

# Logging
LOG_LEVEL=info
